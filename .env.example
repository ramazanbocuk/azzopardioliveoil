# Copy to .env. Never commit .env.

# PostgreSQL. The default below is the bundled local development database
# started with `npm run db:start` (not for production).
# Production: a managed EU database, e.g. Neon (Frankfurt), with sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/azzopardi"

# Public origin of the site. Used for the CSRF origin check and absolute URLs.
APP_URL="http://localhost:3000"

# First administrator, created by `npm run db:seed` if no admin exists yet.
# Choose a long, unique password; it is stored only as an Argon2id hash.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Payments (Stripe Checkout). Use TEST-mode keys until launch.
# Without both values the shop still takes orders but leaves them unpaid.
# Webhook endpoint to register in Stripe: {APP_URL}/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
# Local testing: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Prefer a restricted key (rk_...) from a sandbox over a full secret key (sk_...).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Signs newsletter confirm / unsubscribe links. 32+ random characters.
# Generate one with: openssl rand -base64 48
APP_SECRET=""

# Protects the scheduler endpoint /api/cron/jobs. 24+ random characters.
# The scheduler must send:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Email (Resend). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Azzopardi Olive Oil <orders@your-domain.example>"

# Customer assistant (Anthropic Claude API). See docs/assistant.md.
# Without a key the shop shows no assistant. With a key it still stays off
# until an administrator switches it on and sets a monthly budget in the admin.
ANTHROPIC_API_KEY=""
# Optional. Defaults: claude-opus-5-5 and low.
ASSISTANT_MODEL=""
ASSISTANT_EFFORT=""

# WhatsApp Business Platform (Meta Cloud API). See docs/notifications.md.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Graph API version from Meta's documentation, e.g. the current "vNN.0".
WHATSAPP_API_VERSION=""
# Name and language of the approved template for new-order alerts.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# SMS (Twilio) — optional.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Not implemented: Mollie payments, carrier APIs (bpost, DHL, UPS, Sendcloud).

# Carriers. Each needs a business account with the carrier. Leave empty until you have one:
# the shop then records shipments by hand and books no labels.
# DHL Express — MyDHL API. DHL_EXPRESS_ENV is "test" (default) or "production".
DHL_EXPRESS_API_KEY=""
DHL_EXPRESS_API_SECRET=""
DHL_EXPRESS_ACCOUNT_NUMBER=""
DHL_EXPRESS_ENV="test"
# UPS — developer.ups.com application (client credentials). UPS_ENV is "test" (default, the Customer Integration Environment) or "production".
UPS_CLIENT_ID=""
UPS_CLIENT_SECRET=""
UPS_ACCOUNT_NUMBER=""
UPS_ENV="test"

# FedEx — developer.fedex.com project. FEDEX_ENV is "sandbox" (default) or "production".
FEDEX_CLIENT_ID=""
FEDEX_CLIENT_SECRET=""
FEDEX_ACCOUNT_NUMBER=""
FEDEX_ENV="sandbox"
# bpost — Shipping Manager account id and API passphrase. bpost has no separate test host.
BPOST_ACCOUNT_ID=""
BPOST_PASSPHRASE=""
