// Azzopardi Olive Oil — database schema
//
// Conventions
// - Money is stored as integer euro cents. Never floats.
// - Orders snapshot everything they need (names, prices, addresses), so later
//   catalogue edits never rewrite history.
// - Facts about the oil (origin, analyses, certifications) are nullable and
//   entered by an administrator. Nothing here has a "sensible default".
// - Secrets are never stored: session and cart tokens are kept as SHA-256
//   hashes, passwords as Argon2id hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Category {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  intro          String   @default("")
  position       Int      @default(0)
  isVisible      Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]
}

model Product {
  id                 String          @id @default(cuid())
  slug               String          @unique
  name               String
  blurb              String          @default("")
  description        String          @default("")
  categoryId         String
  isVisible          Boolean         @default(false)
  isFeatured         Boolean         @default(false)
  position           Int             @default(0)
  seoTitle           String?
  seoDescription     String?
  // Administrator-entered label facts. Null = not yet recorded.
  origin             String?
  cultivar           String?
  ingredients        String?
  storage            String?
  /// [{ label, value }] per 100 ml, as printed on the label.
  nutrition          Json?
  // Customs facts for shipments leaving the EU. Administrator-entered; null = not yet recorded.
  hsCode             String?
  customsDescription String?
  originCountry      String?         @db.Char(2)
  // Provenance and tasting profile. Administrator-entered; null = not yet recorded, and shown to customers as a dash.
  // The country of origin is `originCountry` above: one fact, used for customs and for the product page alike.
  producerId         String?
  regionId           String?
  composition        OilComposition?
  extractionMethod   String?
  harvestMethod      String?
  aroma              String?
  taste              String?
  /// 0 (none) to 5 (intense), as judged by the house. Not a laboratory value.
  bitterness         Int?
  pungency           Int?
  pairings           String?
  packaging          String?
  /// When true, customers may order more than is in stock; the rest is sent when it arrives. Off unless the owner switches it on.
  allowBackorder     Boolean         @default(false)
  /// What the shop tells a customer about the wait, in the owner's words. Never generated.
  backorderNote      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  category  Category         @relation(fields: [categoryId], references: [id])
  producer  Producer?        @relation(fields: [producerId], references: [id], onDelete: SetNull)
  region    Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull)
  varieties ProductVariety[]
  variants  Variant[]
  images    ProductImage[]
  batches   Batch[]
  reviews   Review[]

  @@index([categoryId])
  @@index([isVisible, position])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  /// Uploaded photos are kept in the database and served from /media/{id}; null for images hosted elsewhere.
  data      Bytes?
  mime      String?
  bytes     Int?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

/// A purchasable size. New sizes are new rows; nothing is hard-coded to 500/750/1000.
model Variant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  label             String
  volumeMl          Int
  priceCents        Int
  compareAtCents    Int?
  weightGrams       Int
  /// Units that can still be sold or are held for unpaid orders. A paid unit leaves this count at payment, not at dispatch.
  stock             Int      @default(0)
  /// Units held by orders awaiting payment. Available = stock - reserved.
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(6)
  /// EAN/UPC printed on the bottle, for scanning.
  barcode           String?
  /// What one unit costs the business, for stock valuation and margin. Null = not recorded.
  costCents         Int?
  /// Where it is kept: shelf, rack or bin.
  location          String?
  isActive          Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]
  purchaseLines PurchaseOrderLine[]
  cartItems     CartItem[]
  favourites    Favourite[]

  @@index([productId, position])
}

/// One bottling. The lot number printed on the label leads here.
model Batch {
  id          String    @id @default(cuid())
  lotNumber   String    @unique
  productId   String
  harvestDate DateTime? @db.Date
  grove       String?
  mill        String?
  milledAt    DateTime? @db.Date
  bottledAt   DateTime? @db.Date
  bestBefore  DateTime? @db.Date
  notes       String?
  /// Who supplied this lot (grower, mill or bottler). Internal: never shown to customers.
  supplierId  String?
  /// The harvest campaign, e.g. 2026 for olives picked in autumn 2026. Each batch has its own.
  harvestYear Int?
  /// Who made this batch, when it differs from the product's usual producer.
  producerId  String?
  /// Only published batches are visible to customers.
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product    Product         @relation(fields: [productId], references: [id])
  supplier   Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  producer   Producer?       @relation(fields: [producerId], references: [id], onDelete: SetNull)
  documents  BatchDocument[]
  labResults LabResult[]

  @@index([productId, isPublished])
}

enum BatchDocumentKind {
  ANALYSIS
  CERTIFICATION
  AWARD
  OTHER
}

/// Proof for a claim. Shown publicly only once an administrator has verified it.
model BatchDocument {
  id           String            @id @default(cuid())
  batchId      String
  kind         BatchDocumentKind
  title        String
  url          String
  /// An uploaded PDF is kept in the database and served from /media/certificate/{id} once verified and its batch is published.
  data         Bytes?
  mime         String?
  bytes        Int?
  uploadedById String?
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime          @default(now())

  batch      Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  verifiedBy AdminUser?  @relation(fields: [verifiedById], references: [id])
  labResults LabResult[]

  @@index([batchId])
}

enum InventoryReason {
  RECEIVED
  ADJUSTMENT
  SALE
  RETURN
  DAMAGED
}

model InventoryMovement {
  id          String          @id @default(cuid())
  variantId   String
  delta       Int
  reason      InventoryReason
  orderId     String?
  adminUserId String?
  note        String?
  createdAt   DateTime        @default(now())

  variant Variant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
}

// ───────────────────────────── Customers ─────────────────────────────

model Customer {
  id                   String          @id @default(cuid())
  /// Always stored lower-cased.
  email                String          @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  locale               String          @default("en")
  marketingOptIn       Boolean         @default(false)
  emailVerifiedAt      DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  /// Set when the account is erased on request; personal fields are blanked.
  erasedAt             DateTime?
  // Wholesale (B2B). Terms are set by staff; APPROVED accounts get their discount automatically.
  wholesaleStatus      WholesaleStatus @default(NONE)
  companyName          String?
  companyVatNumber     String?
  /// Standing discount on goods, percent × 100 (15% = 1500).
  wholesaleDiscountBps Int             @default(0)
  wholesaleNote        String?
  /// Free labels set by staff, e.g. VIP, Restaurant, Press.
  tags                 String[]        @default([])

  sessions   CustomerSession[]
  addresses  Address[]
  favourites Favourite[]
  orders     Order[]
  reviews    Review[]
  carts      Cart[]
  notes      CustomerNote[]
}

model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  userAgent  String?
  ip         String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  firstName   String
  lastName    String
  line1       String
  line2       String?
  postalCode  String
  city        String
  region      String?
  countryCode String   @db.Char(2)
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Favourite {
  customerId String
  variantId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([customerId, variantId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  customerId String
  /// The delivered order that entitles this customer to review.
  orderId    String
  rating     Int
  title      String       @default("")
  body       String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId, status])
}

enum NewsletterStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id        String           @id @default(cuid())
  email     String           @unique
  status    NewsletterStatus @default(PENDING)
  /// Hash of the confirm/unsubscribe token (double opt-in).
  tokenHash String           @unique
  locale    String           @default("en")
  source    String           @default("site")
  consentAt DateTime?
  createdAt DateTime         @default(now())
}

// ───────────────────────────── Cart & pricing ─────────────────────────────

model Cart {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  customerId   String?
  discountCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([updatedAt])
}

model CartItem {
  cartId    String
  variantId String
  quantity  Int
  addedAt   DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
}

enum DiscountKind {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Discount {
  id               String       @id @default(cuid())
  /// Always stored upper-cased.
  code             String       @unique
  kind             DiscountKind
  /// Percent (1–100) for PERCENT, cents for FIXED, ignored for FREE_SHIPPING.
  value            Int          @default(0)
  minSubtotalCents Int          @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  usedCount        Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
}

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  /// ISO 3166-1 alpha-2 codes.
  countries String[]
  isActive  Boolean        @default(true)
  rates     ShippingRate[]
}

model ShippingRate {
  id             String       @id @default(cuid())
  zoneId         String
  name           String
  /// Carrier key used by the shipping provider adapters (e.g. "bpost").
  carrier        String?
  priceCents     Int
  /// Weight band this rate applies to. A flat rate leaves both at their defaults.
  minWeightGrams Int          @default(0)
  maxWeightGrams Int?
  /// Subtotal from which this rate becomes free. Null = never free.
  freeAboveCents Int?
  estimate       String?
  isActive       Boolean      @default(true)
  position       Int          @default(0)
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, isActive])
}

/// VAT by destination. Rates are entered by the administrator and must be
/// confirmed with an accountant; the system ships with none.
model TaxRate {
  id          String  @id @default(cuid())
  countryCode String  @unique @db.Char(2)
  /// Percent with two decimals, stored ×100 (6% = 600).
  rateBps     Int
  label       String  @default("VAT")
  isActive    Boolean @default(true)
}

// ───────────────────────────── Orders ─────────────────────────────

/// One headline state, derived from payment and fulfilment by `deriveOrderStatus`. Never set by hand.
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PROCESSING
  READY_FOR_FULFILMENT
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfilmentStatus {
  UNFULFILLED
  PROCESSING
  READY
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
}

enum PaymentStatus {
  UNPAID
  /// The customer finished checkout with a delayed method; the money has not arrived yet.
  PROCESSING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

model Order {
  id               String           @id @default(cuid())
  /// Human number is derived from this: AZZ-{1000 + sequence}.
  sequence         Int              @unique @default(autoincrement())
  number           String?          @unique
  customerId       String?
  email            String
  status           OrderStatus      @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus    @default(UNPAID)
  fulfilmentStatus FulfilmentStatus @default(UNFULFILLED)
  currency         String           @default("EUR") @db.Char(3)
  locale           String           @default("en")
  subtotalCents    Int
  discountCents    Int              @default(0)
  shippingCents    Int
  /// VAT contained in the total. Null when no rate was configured for the destination.
  taxCents         Int?
  taxRateBps       Int?
  /// VAT contained in the shipping charge. Part of taxCents.
  shippingTaxCents Int?
  totalCents       Int
  discountCode     String?
  shippingRateName String
  shippingCarrier  String?
  weightGrams      Int
  // Delivery address snapshot
  shipFirstName    String
  shipLastName     String
  shipLine1        String
  shipLine2        String?
  shipPostalCode   String
  shipCity         String
  shipRegion       String?
  shipCountryCode  String           @db.Char(2)
  shipPhone        String?
  // Billing address snapshot (equal to delivery unless the customer gave another)
  billFirstName    String
  billLastName     String
  billCompany      String?
  billVatNumber    String?
  billLine1        String
  billLine2        String?
  billPostalCode   String
  billCity         String
  billRegion       String?
  billCountryCode  String           @db.Char(2)
  customerNote     String?
  /// Hash of the link token that lets a guest open their own order page.
  accessTokenHash  String?
  /// Reservation is released if still unpaid after this moment.
  reservedUntil    DateTime?
  placedAt         DateTime         @default(now())
  paidAt           DateTime?
  cancelledAt      DateTime?
  updatedAt        DateTime         @updatedAt

  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]
  events    OrderEvent[]
  notes     OrderNote[]
  returns   ReturnRequest[]

  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@index([fulfilmentStatus, placedAt])
  @@index([email])
}

model OrderItem {
  id                String             @id @default(cuid())
  orderId           String
  variantId         String?
  sku               String
  productName       String
  variantLabel      String
  lotNumber         String?
  unitPriceCents    Int
  quantity          Int
  lineTotalCents    Int
  /// VAT rate applied to this line (percent × 100) and the VAT contained in it after discount.
  taxRateBps        Int?
  taxCents          Int?
  /// Units of this line already sent in a shipment.
  shippedQuantity   Int                @default(0)
  /// Units that were not in stock when the order was placed. Fixed at checkout; what is still owed is on the Backorder row.
  backorderQuantity Int                @default(0)
  /// Units taken off the order after payment because they will not be supplied.
  cancelledQuantity Int                @default(0)
  // Customs snapshot, needed on labels for destinations outside the EU
  weightGrams       Int                @default(0)
  hsCode            String?
  originCountry     String?            @db.Char(2)
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentItems     ShipmentItem[]
  backorder         Backorder?
  reservations      StockReservation[]

  @@index([orderId])
}

/// Customer-visible timeline.
model OrderEvent {
  id          String     @id @default(cuid())
  orderId     String
  kind        String
  message     String
  /// The staff member who caused it; null for the customer, the payment provider or the system.
  adminUserId String?
  /// Internal events are shown to staff only, never on the customer's order page.
  isInternal  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

/// Internal only. Never exposed through the storefront API.
model OrderNote {
  id          String    @id @default(cuid())
  orderId     String
  adminUserId String
  body        String
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author      AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([orderId])
}

enum PaymentProvider {
  STRIPE
  MOLLIE
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  provider    PaymentProvider
  /// The provider's own id (PaymentIntent, Mollie payment id).
  providerRef String
  status      PaymentStatus   @default(UNPAID)
  amountCents Int
  currency    String          @default("EUR") @db.Char(3)
  method      String?
  /// The provider's id for the money itself (Stripe PaymentIntent). Refunds and disputes refer to this, not to the checkout.
  intentRef   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds  Refund[]
  disputes Dispute[]

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([intentRef])
}

model Refund {
  id          String    @id @default(cuid())
  paymentId   String
  amountCents Int
  reason      String?
  /// The provider's refund id. Unique, so a refund reported twice (by staff and by the provider) is one row.
  providerRef String?   @unique
  /// Null when the refund was made outside this admin panel, e.g. in the Stripe Dashboard.
  adminUserId String?
  /// Set when the provider reports that the refund did not reach the customer. Failed refunds count for nothing.
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

/// A cardholder contesting a payment with their bank (chargeback). Mirrors the provider; it is answered in the provider's dashboard.
model Dispute {
  id            String    @id @default(cuid())
  paymentId     String
  providerRef   String    @unique
  amountCents   Int
  currency      String    @db.Char(3)
  reason        String?
  /// The provider's own status word, e.g. needs_response, under_review, won, lost.
  status        String
  evidenceDueAt DateTime?
  /// When the provider produced the newest event applied here; older events arriving late are ignored.
  providerAt    DateTime
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

/// Every verified webhook is recorded once; a repeat delivery is a no-op.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
  CANCELLED
}

model Shipment {
  id                  String          @id @default(cuid())
  orderId             String
  carrier             String
  /// The carrier's product, e.g. "bpack 24h Pro" or "Express Worldwide".
  service             String?
  /// The carrier's own id for the booking, used to cancel it or fetch its label.
  carrierRef          String?
  trackingNumber      String?
  trackingUrl         String?
  labelUrl            String?
  status              ShipmentStatus  @default(PENDING)
  /// What the carrier charges us, when known. Not what the customer paid.
  costCents           Int?
  estimatedDeliveryAt DateTime?
  /// "carrier" when booked through a carrier's API, "manual" when typed in by staff.
  source              String          @default("manual")
  /// The carrier's tracking history, as last read: [{ at, description, location }].
  trackingEvents      Json?
  trackingCheckedAt   DateTime?
  /// Set while the carrier reports a problem with delivery (wrong address, refused, held at customs…). Cleared when the parcel moves again or is delivered.
  exceptionAt         DateTime?
  exceptionNote       String?
  cancelledAt         DateTime?
  adminUserId         String?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime        @default(now())
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parcels             Parcel[]
  items               ShipmentItem[]
  labels              ShipmentLabel[]
  events              TrackingEvent[]

  @@index([orderId])
}

/// One physical box in a shipment.
model Parcel {
  id             String   @id @default(cuid())
  shipmentId     String
  weightGrams    Int
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  trackingNumber String?
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

/// One attempt to book a shipment with a carrier. Written BEFORE the carrier is called, so a
/// second click, a retry or a second person can never book (and pay for) the same parcel twice.
model ShipmentAttempt {
  id          String   @id @default(cuid())
  orderId     String
  /// Which units this attempt covers: the same units cannot be attempted twice at once.
  fingerprint String
  carrier     String
  service     String
  /// STARTED while the carrier is being called; SUCCEEDED or FAILED once it answers;
  /// UNKNOWN when it never answered, so staff must check with the carrier before trying again.
  status      String   @default("STARTED")
  shipmentId  String?
  error       String?
  adminUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId, fingerprint, status])
}

/// A label document exactly as the carrier issued it. Kept in the database so it can be reprinted.
model ShipmentLabel {
  id             String   @id @default(cuid())
  shipmentId     String
  position       Int      @default(0)
  mime           String
  data           Bytes
  trackingNumber String?
  createdAt      DateTime @default(now())
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, position])
}

/// Which order lines, and how many units, a shipment carries. Makes part-shipments possible.
model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int
  /// The lot these units came from. Two shipments of one order line can come from different lots.
  lotNumber   String?
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  status    ReturnStatus @default(REQUESTED)
  reason    String
  /// [{ orderItemId, quantity }]
  items     Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ───────────────────────────── Administration ─────────────────────────────

/// What each role may do is defined in src/server/permissions.ts.
enum AdminRole {
  SUPER_ADMINISTRATOR
  ADMINISTRATOR
  OPERATIONS_MANAGER
  WAREHOUSE_MANAGER
  SHIPPING_MANAGER
  CUSTOMER_SUPPORT
  ACCOUNTANT
  MARKETING_MANAGER
  ANALYST
  MANAGER
  STAFF
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          AdminRole @default(STAFF)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  /// Authenticator secret, encrypted with APP_SECRET. Present while enrolling; enforced once totpEnabledAt is set.
  totpSecret    String?
  totpEnabledAt DateTime?

  sessions          AdminSession[]
  notes             OrderNote[]
  verifiedDocuments BatchDocument[]
  orderEvents       OrderEvent[]
}

model AdminSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  ip          String?
  userAgent   String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Append-only record of sensitive actions by staff and by the system.
model AuditLog {
  id        String   @id @default(cuid())
  actorType String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  /// Deliberately not sent: the channel is switched off or not connected.
  SKIPPED
}

/// Transactional outbox. A row is written in the same transaction as the
/// business change, then delivered with retries. `dedupeKey` makes a job
/// impossible to enqueue twice (e.g. one WhatsApp message per paid order).
model OutboxJob {
  id        String    @id @default(cuid())
  kind      String
  payload   Json
  dedupeKey String    @unique
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAfter  DateTime  @default(now())
  lastError String?
  /// Set while a worker holds the job; a stale lock is released after ten minutes.
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([status, runAfter])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Fixed-window counters for login, lookup and form endpoints.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

enum WholesaleStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

/// A grower, mill, bottler or packaging supplier. Internal records for traceability and purchasing.
model Supplier {
  id             String          @id @default(cuid())
  name           String
  /// What they supply: Grower, Mill, Bottler, Packaging, Logistics, Other.
  kind           String          @default("Other")
  contactName    String?
  email          String?
  phone          String?
  address        String?
  countryCode    String?         @db.Char(2)
  vatNumber      String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  batches        Batch[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive, name])
}

/// Stock ordered from a supplier. Receiving it adds the units to stock and records what they cost.
model PurchaseOrder {
  id          String              @id @default(cuid())
  sequence    Int                 @unique @default(autoincrement())
  supplierId  String
  /// DRAFT, ORDERED, RECEIVED or CANCELLED.
  status      String              @default("DRAFT")
  expectedAt  DateTime?           @db.Date
  orderedAt   DateTime?
  receivedAt  DateTime?
  notes       String?
  adminUserId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  lines       PurchaseOrderLine[]

  @@index([status, createdAt])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  variantId       String
  quantity        Int
  unitCostCents   Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         Variant       @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
}

/// A staff note about a customer. Never shown to the customer, but part of their data on a GDPR request.
model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  adminUserId String?
  body        String
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model JournalPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  kind        String    @default("Story")
  title       String
  standfirst  String    @default("")
  body        String    @default("")
  /// Recipe details: { serves, time, ingredients[], method[] }
  recipe      Json?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// A translation of one record (product, category, journal post) into one language.
/// English is the source and lives on the record itself; it is never stored here.
/// Customers only ever see `published`. `draft` is the editor's working copy.
model Translation {
  id            String    @id @default(cuid())
  /// "product", "category" or "journal".
  entity        String
  entityId      String
  /// Two-letter language: de, nl, fr, it, es.
  language      String
  /// Field name → text, as being edited. Never shown to customers.
  draft         Json
  /// Field name → text, as customers see it. Null until someone with permission publishes.
  published     Json?
  /// Fingerprint of the English source when this was published. A different fingerprint today means the source has changed since.
  sourceHash    String?
  updatedById   String?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  revisions TranslationRevision[]

  @@unique([entity, entityId, language])
  @@index([entity, language])
}

/// Every save, publication and withdrawal of a translation, with who did it.
model TranslationRevision {
  id            String      @id @default(cuid())
  translationId String
  /// "draft", "publish" or "unpublish".
  action        String
  fields        Json
  adminUserId   String?
  createdAt     DateTime    @default(now())
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([translationId, createdAt])
}

enum OilComposition {
  SINGLE_VARIETY
  BLEND
}

/// A growing region within a country, e.g. Crete in GR. Countries themselves are ISO codes and need no table.
model Region {
  id          String     @id @default(cuid())
  countryCode String     @db.Char(2)
  name        String
  createdAt   DateTime   @default(now())
  products    Product[]
  producers   Producer[]

  @@unique([countryCode, name])
}

/// Who makes an oil: an estate, a mill or a cooperative. Shown to customers by name once marked public.
/// A Supplier is who the business buys from and is never shown; the two may or may not be the same company.
model Producer {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  countryCode String?   @db.Char(2)
  regionId    String?
  town        String?
  description String    @default("")
  website     String?
  /// Only public producers are named on the shop.
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  region      Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  products    Product[]
  batches     Batch[]
}

model OliveVariety {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String           @unique
  description String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  products    ProductVariety[]
}

/// Which varieties an oil is made from. `percent` is optional and, when given for a blend, the shares add up to 100.
model ProductVariety {
  productId String
  varietyId String
  percent   Int?
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  variety   OliveVariety @relation(fields: [varietyId], references: [id], onDelete: Cascade)

  @@id([productId, varietyId])
  @@index([varietyId])
}

/// One measured value for one batch, as reported by a laboratory.
/// Customers see a result only when it is verified and its batch is published.
/// A result is never edited: a wrong one is deleted and entered again, so the record of who verified what stays true.
model LabResult {
  id           String         @id @default(cuid())
  batchId      String
  /// A key from the list of measures in src/server/provenance.ts, or "other".
  measure      String
  /// Name of the measure when it is "other".
  label        String?
  value        Decimal        @db.Decimal(12, 4)
  unit         String
  method       String?
  laboratory   String?
  testedAt     DateTime?      @db.Date
  /// The certificate this value was read from.
  documentId   String?
  note         String?
  createdById  String?
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime       @default(now())
  batch        Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  document     BatchDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([batchId])
}

enum ReservationStatus {
  /// Stock is held for an order awaiting payment.
  HELD
  /// The order was paid: the units were sold.
  CONVERTED
  /// The order was cancelled or its hold expired: the units went back on sale.
  RELEASED
}

/// One hold of stock for one order line, from checkout until payment or expiry.
/// `Variant.reserved` is the running total of HELD rows; this table is the record of who holds what.
model StockReservation {
  id          String            @id @default(cuid())
  orderId     String
  orderItemId String
  variantId   String
  quantity    Int
  status      ReservationStatus @default(HELD)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  closedAt    DateTime?
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([variantId, status])
  @@index([orderId])
}

/// Units a customer has paid for that were not in stock. Created when the order is paid.
/// Open = quantity - filledQuantity - cancelledQuantity. Arriving stock fills the oldest open backorder first.
model Backorder {
  id                String    @id @default(cuid())
  orderId           String
  orderItemId       String    @unique
  variantId         String
  quantity          Int
  filledQuantity    Int       @default(0)
  cancelledQuantity Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// When nothing was left open.
  closedAt          DateTime?
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([variantId, closedAt, createdAt])
  @@index([orderId])
}

/// One thing a carrier reported about a parcel, or that staff recorded by hand for a shipment without carrier tracking.
/// Rows replace the JSON kept on Shipment.trackingEvents, which is no longer written.
model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  occurredAt  DateTime
  description String
  location    String?
  /// The carrier's own code for the event, when it gives one.
  code        String?
  /// INFO, OUT_FOR_DELIVERY, EXCEPTION, DELIVERED or RETURNED.
  kind        String   @default("INFO")
  /// "carrier" when read from the carrier's API, "manual" when typed by staff.
  source      String   @default("carrier")
  adminUserId String?
  createdAt   DateTime @default(now())
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, occurredAt, description])
  @@index([shipmentId, occurredAt])
}

/// One chat with an assistant. "customer" conversations happen on the shop; "admin" ones in the admin panel.
/// A guest's conversation is tied to a random key kept in an HttpOnly cookie, never to an IP address.
model AiConversation {
  id              String           @id @default(cuid())
  channel         String           @default("customer")
  customerId      String?
  adminUserId     String?
  /// SHA-256 of the guest's conversation cookie. Null for signed-in customers and staff.
  guestKeyHash    String?
  locale          String           @default("en")
  /// OPEN, HANDED_OVER (a person has been asked to take over) or CLOSED.
  status          String           @default("OPEN")
  /// What the customer thought of it, if they said: 1 helpful, -1 not helpful.
  rating          Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        AiMessage[]
  toolCalls       AiToolCall[]
  supportRequests SupportRequest[]
  proposals       AiProposal[]

  @@index([channel, updatedAt])
  @@index([customerId])
  @@index([guestKeyHash])
  @@index([adminUserId])
}

/// One turn. `content` holds the exact blocks exchanged with the model, so a conversation can be continued without altering what was said.
model AiMessage {
  id               String         @id @default(cuid())
  conversationId   String
  /// "user", "assistant", or "tool" (tool results sent back to the model).
  role             String
  /// The text a person typed or read. Empty for tool turns.
  text             String         @default("")
  content          Json
  model            String?
  stopReason       String?
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  cacheReadTokens  Int            @default(0)
  cacheWriteTokens Int            @default(0)
  /// Estimated cost in millionths of a US dollar, from the published price per token. An estimate, not an invoice.
  costMicros       Int            @default(0)
  /// Set when the turn failed; the message says why.
  error            String?
  createdAt        DateTime       @default(now())
  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

/// Every tool an assistant used: what it asked for, whether it was allowed, how long it took. The audit trail of what the AI did.
model AiToolCall {
  id             String         @id @default(cuid())
  conversationId String
  name           String
  input          Json
  ok             Boolean
  /// Why it failed or was refused.
  error          String?
  durationMs     Int            @default(0)
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([name, createdAt])
}

/// Something the staff assistant suggested doing. Nothing happens until a
/// person with the right role approves it; then the same service the admin
/// panel uses is run, as that person.
model AiProposal {
  id             String         @id @default(cuid())
  sequence       Int            @unique @default(autoincrement())
  conversationId String
  /// The staff member the assistant was talking to. Only they can approve or reject it.
  adminUserId    String
  /// refund, cancel_units, stock_adjustment or support_status.
  kind           String
  params         Json
  /// What will happen, written by the server from the database, not by the model.
  summary        String
  /// PENDING, EXECUTING, EXECUTED, REJECTED, FAILED or EXPIRED.
  status         String         @default("PENDING")
  result         String?
  decidedById    String?
  decidedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([adminUserId, status])
  @@index([conversationId])
  @@index([status, createdAt])
}

/// A question for a person: created by the assistant when it hands over, or by staff.
model SupportRequest {
  id             String          @id @default(cuid())
  sequence       Int             @unique @default(autoincrement())
  conversationId String?
  customerId     String?
  email          String
  name           String?
  subject        String
  body           String
  orderNumber    String?
  locale         String          @default("en")
  /// "assistant", "contact" or "staff".
  source         String          @default("assistant")
  /// OPEN, ANSWERED or CLOSED.
  status         String          @default("OPEN")
  /// Set by the assistant when the customer sounds upset or the matter is about money, safety or a missing parcel.
  urgent         Boolean         @default(false)
  handledById    String?
  handledAt      DateTime?
  staffNote      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([customerId])
}

/// Approved knowledge the assistants may quote: how the shop works, how to store oil, what terms mean.
/// Only published articles are searched. Facts about a product or a batch never live here; they come from the product's own data.
model KnowledgeArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  /// "customer" articles may be quoted to customers; "staff" ones only to the admin assistant.
  audience    String   @default("customer")
  isPublished Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([audience, isPublished])
}
