// Azzopardi Olive Oil — database schema
//
// Conventions
// - Money is stored as integer euro cents. Never floats.
// - Orders snapshot everything they need (names, prices, addresses), so later
//   catalogue edits never rewrite history.
// - Facts about the oil (origin, analyses, certifications) are nullable and
//   entered by an administrator. Nothing here has a "sensible default".
// - Secrets are never stored: session and cart tokens are kept as SHA-256
//   hashes, passwords as Argon2id hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Category {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  intro          String   @default("")
  position       Int      @default(0)
  isVisible      Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products     Product[]
  translations CategoryTranslation[]
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String
  name       String
  intro      String   @default("")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  blurb              String    @default("")
  description        String    @default("")
  categoryId         String
  isVisible          Boolean   @default(false)
  isFeatured         Boolean   @default(false)
  position           Int       @default(0)
  seoTitle           String?
  seoDescription     String?
  // Administrator-entered label facts. Null = not yet recorded.
  origin             String?
  cultivar           String?
  ingredients        String?
  storage            String?
  /// [{ label, value }] per 100 ml, as printed on the label.
  nutrition          Json?
  // Customs facts for shipments leaving the EU. Administrator-entered; null = not yet recorded.
  hsCode             String?
  customsDescription String?
  originCountry      String?   @db.Char(2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  category     Category             @relation(fields: [categoryId], references: [id])
  variants     Variant[]
  images       ProductImage[]
  batches      Batch[]
  reviews      Review[]
  translations ProductTranslation[]

  @@index([categoryId])
  @@index([isVisible, position])
}

model ProductTranslation {
  id             String  @id @default(cuid())
  productId      String
  locale         String
  name           String
  blurb          String  @default("")
  description    String  @default("")
  seoTitle       String?
  seoDescription String?
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  /// Uploaded photos are kept in the database and served from /media/{id}; null for images hosted elsewhere.
  data      Bytes?
  mime      String?
  bytes     Int?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

/// A purchasable size. New sizes are new rows; nothing is hard-coded to 500/750/1000.
model Variant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  label             String
  volumeMl          Int
  priceCents        Int
  compareAtCents    Int?
  weightGrams       Int
  /// Units physically on hand.
  stock             Int      @default(0)
  /// Units held by orders awaiting payment. Available = stock - reserved.
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(6)
  /// EAN/UPC printed on the bottle, for scanning.
  barcode           String?
  /// What one unit costs the business, for stock valuation and margin. Null = not recorded.
  costCents         Int?
  /// Where it is kept: shelf, rack or bin.
  location          String?
  isActive          Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]
  purchaseLines PurchaseOrderLine[]
  cartItems     CartItem[]
  favourites    Favourite[]

  @@index([productId, position])
}

/// One bottling. The lot number printed on the label leads here.
model Batch {
  id          String    @id @default(cuid())
  lotNumber   String    @unique
  productId   String
  harvestDate DateTime? @db.Date
  grove       String?
  mill        String?
  milledAt    DateTime? @db.Date
  bottledAt   DateTime? @db.Date
  bestBefore  DateTime? @db.Date
  notes       String?
  /// Who supplied this lot (grower, mill or bottler). Internal: never shown to customers.
  supplierId  String?
  /// Only published batches are visible to customers.
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product   Product         @relation(fields: [productId], references: [id])
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  documents BatchDocument[]

  @@index([productId, isPublished])
}

enum BatchDocumentKind {
  ANALYSIS
  CERTIFICATION
  AWARD
  OTHER
}

/// Proof for a claim. Shown publicly only once an administrator has verified it.
model BatchDocument {
  id           String            @id @default(cuid())
  batchId      String
  kind         BatchDocumentKind
  title        String
  url          String
  verifiedAt   DateTime?
  verifiedById String?
  createdAt    DateTime          @default(now())

  batch      Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  verifiedBy AdminUser? @relation(fields: [verifiedById], references: [id])

  @@index([batchId])
}

enum InventoryReason {
  RECEIVED
  ADJUSTMENT
  SALE
  RETURN
  DAMAGED
}

model InventoryMovement {
  id          String          @id @default(cuid())
  variantId   String
  delta       Int
  reason      InventoryReason
  orderId     String?
  adminUserId String?
  note        String?
  createdAt   DateTime        @default(now())

  variant Variant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
}

// ───────────────────────────── Customers ─────────────────────────────

model Customer {
  id                   String          @id @default(cuid())
  /// Always stored lower-cased.
  email                String          @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  locale               String          @default("en")
  marketingOptIn       Boolean         @default(false)
  emailVerifiedAt      DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  /// Set when the account is erased on request; personal fields are blanked.
  erasedAt             DateTime?
  // Wholesale (B2B). Terms are set by staff; APPROVED accounts get their discount automatically.
  wholesaleStatus      WholesaleStatus @default(NONE)
  companyName          String?
  companyVatNumber     String?
  /// Standing discount on goods, percent × 100 (15% = 1500).
  wholesaleDiscountBps Int             @default(0)
  wholesaleNote        String?
  /// Free labels set by staff, e.g. VIP, Restaurant, Press.
  tags                 String[]        @default([])

  sessions   CustomerSession[]
  addresses  Address[]
  favourites Favourite[]
  orders     Order[]
  reviews    Review[]
  carts      Cart[]
  notes      CustomerNote[]
}

model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  userAgent  String?
  ip         String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  firstName   String
  lastName    String
  line1       String
  line2       String?
  postalCode  String
  city        String
  region      String?
  countryCode String   @db.Char(2)
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Favourite {
  customerId String
  variantId  String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variant  Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([customerId, variantId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  customerId String
  /// The delivered order that entitles this customer to review.
  orderId    String
  rating     Int
  title      String       @default("")
  body       String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId, status])
}

enum NewsletterStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id        String           @id @default(cuid())
  email     String           @unique
  status    NewsletterStatus @default(PENDING)
  /// Hash of the confirm/unsubscribe token (double opt-in).
  tokenHash String           @unique
  locale    String           @default("en")
  source    String           @default("site")
  consentAt DateTime?
  createdAt DateTime         @default(now())
}

// ───────────────────────────── Cart & pricing ─────────────────────────────

model Cart {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  customerId   String?
  discountCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([updatedAt])
}

model CartItem {
  cartId    String
  variantId String
  quantity  Int
  addedAt   DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([cartId, variantId])
}

enum DiscountKind {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Discount {
  id               String       @id @default(cuid())
  /// Always stored upper-cased.
  code             String       @unique
  kind             DiscountKind
  /// Percent (1–100) for PERCENT, cents for FIXED, ignored for FREE_SHIPPING.
  value            Int          @default(0)
  minSubtotalCents Int          @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  usedCount        Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
}

model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  /// ISO 3166-1 alpha-2 codes.
  countries String[]
  isActive  Boolean        @default(true)
  rates     ShippingRate[]
}

model ShippingRate {
  id             String       @id @default(cuid())
  zoneId         String
  name           String
  /// Carrier key used by the shipping provider adapters (e.g. "bpost").
  carrier        String?
  priceCents     Int
  /// Weight band this rate applies to. A flat rate leaves both at their defaults.
  minWeightGrams Int          @default(0)
  maxWeightGrams Int?
  /// Subtotal from which this rate becomes free. Null = never free.
  freeAboveCents Int?
  estimate       String?
  isActive       Boolean      @default(true)
  position       Int          @default(0)
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId, isActive])
}

/// VAT by destination. Rates are entered by the administrator and must be
/// confirmed with an accountant; the system ships with none.
model TaxRate {
  id          String  @id @default(cuid())
  countryCode String  @unique @db.Char(2)
  /// Percent with two decimals, stored ×100 (6% = 600).
  rateBps     Int
  label       String  @default("VAT")
  isActive    Boolean @default(true)
}

// ───────────────────────────── Orders ─────────────────────────────

/// One headline state, derived from payment and fulfilment by `deriveOrderStatus`. Never set by hand.
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PROCESSING
  READY_FOR_FULFILMENT
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfilmentStatus {
  UNFULFILLED
  PROCESSING
  READY
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
}

enum PaymentStatus {
  UNPAID
  /// The customer finished checkout with a delayed method; the money has not arrived yet.
  PROCESSING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

model Order {
  id               String           @id @default(cuid())
  /// Human number is derived from this: AZZ-{1000 + sequence}.
  sequence         Int              @unique @default(autoincrement())
  number           String?          @unique
  customerId       String?
  email            String
  status           OrderStatus      @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus    @default(UNPAID)
  fulfilmentStatus FulfilmentStatus @default(UNFULFILLED)
  currency         String           @default("EUR") @db.Char(3)
  locale           String           @default("en")
  subtotalCents    Int
  discountCents    Int              @default(0)
  shippingCents    Int
  /// VAT contained in the total. Null when no rate was configured for the destination.
  taxCents         Int?
  taxRateBps       Int?
  /// VAT contained in the shipping charge. Part of taxCents.
  shippingTaxCents Int?
  totalCents       Int
  discountCode     String?
  shippingRateName String
  shippingCarrier  String?
  weightGrams      Int
  // Delivery address snapshot
  shipFirstName    String
  shipLastName     String
  shipLine1        String
  shipLine2        String?
  shipPostalCode   String
  shipCity         String
  shipRegion       String?
  shipCountryCode  String           @db.Char(2)
  shipPhone        String?
  // Billing address snapshot (equal to delivery unless the customer gave another)
  billFirstName    String
  billLastName     String
  billCompany      String?
  billVatNumber    String?
  billLine1        String
  billLine2        String?
  billPostalCode   String
  billCity         String
  billRegion       String?
  billCountryCode  String           @db.Char(2)
  customerNote     String?
  /// Hash of the link token that lets a guest open their own order page.
  accessTokenHash  String?
  /// Reservation is released if still unpaid after this moment.
  reservedUntil    DateTime?
  placedAt         DateTime         @default(now())
  paidAt           DateTime?
  cancelledAt      DateTime?
  updatedAt        DateTime         @updatedAt

  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]
  events    OrderEvent[]
  notes     OrderNote[]
  returns   ReturnRequest[]

  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@index([fulfilmentStatus, placedAt])
  @@index([email])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  variantId       String?
  sku             String
  productName     String
  variantLabel    String
  lotNumber       String?
  unitPriceCents  Int
  quantity        Int
  lineTotalCents  Int
  /// VAT rate applied to this line (percent × 100) and the VAT contained in it after discount.
  taxRateBps      Int?
  taxCents        Int?
  /// Units of this line already sent in a shipment.
  shippedQuantity Int            @default(0)
  // Customs snapshot, needed on labels for destinations outside the EU
  weightGrams     Int            @default(0)
  hsCode          String?
  originCountry   String?        @db.Char(2)
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentItems   ShipmentItem[]

  @@index([orderId])
}

/// Customer-visible timeline.
model OrderEvent {
  id          String     @id @default(cuid())
  orderId     String
  kind        String
  message     String
  /// The staff member who caused it; null for the customer, the payment provider or the system.
  adminUserId String?
  /// Internal events are shown to staff only, never on the customer's order page.
  isInternal  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor       AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

/// Internal only. Never exposed through the storefront API.
model OrderNote {
  id          String    @id @default(cuid())
  orderId     String
  adminUserId String
  body        String
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author      AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([orderId])
}

enum PaymentProvider {
  STRIPE
  MOLLIE
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  provider    PaymentProvider
  /// The provider's own id (PaymentIntent, Mollie payment id).
  providerRef String
  status      PaymentStatus   @default(UNPAID)
  amountCents Int
  currency    String          @default("EUR") @db.Char(3)
  method      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, providerRef])
  @@index([orderId])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  amountCents Int
  reason      String?
  providerRef String?
  adminUserId String?
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

/// Every verified webhook is recorded once; a repeat delivery is a no-op.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  RETURNED
  FAILED
  CANCELLED
}

model Shipment {
  id                  String          @id @default(cuid())
  orderId             String
  carrier             String
  /// The carrier's product, e.g. "bpack 24h Pro" or "Express Worldwide".
  service             String?
  /// The carrier's own id for the booking, used to cancel it or fetch its label.
  carrierRef          String?
  trackingNumber      String?
  trackingUrl         String?
  labelUrl            String?
  status              ShipmentStatus  @default(PENDING)
  /// What the carrier charges us, when known. Not what the customer paid.
  costCents           Int?
  estimatedDeliveryAt DateTime?
  /// "carrier" when booked through a carrier's API, "manual" when typed in by staff.
  source              String          @default("manual")
  /// The carrier's tracking history, as last read: [{ at, description, location }].
  trackingEvents      Json?
  trackingCheckedAt   DateTime?
  cancelledAt         DateTime?
  adminUserId         String?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime        @default(now())
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parcels             Parcel[]
  items               ShipmentItem[]
  labels              ShipmentLabel[]

  @@index([orderId])
}

/// One physical box in a shipment.
model Parcel {
  id             String   @id @default(cuid())
  shipmentId     String
  weightGrams    Int
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  trackingNumber String?
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

/// One attempt to book a shipment with a carrier. Written BEFORE the carrier is called, so a
/// second click, a retry or a second person can never book (and pay for) the same parcel twice.
model ShipmentAttempt {
  id          String   @id @default(cuid())
  orderId     String
  /// Which units this attempt covers: the same units cannot be attempted twice at once.
  fingerprint String
  carrier     String
  service     String
  /// STARTED while the carrier is being called; SUCCEEDED or FAILED once it answers;
  /// UNKNOWN when it never answered, so staff must check with the carrier before trying again.
  status      String   @default("STARTED")
  shipmentId  String?
  error       String?
  adminUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId, fingerprint, status])
}

/// A label document exactly as the carrier issued it. Kept in the database so it can be reprinted.
model ShipmentLabel {
  id             String   @id @default(cuid())
  shipmentId     String
  position       Int      @default(0)
  mime           String
  data           Bytes
  trackingNumber String?
  createdAt      DateTime @default(now())
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, position])
}

/// Which order lines, and how many units, a shipment carries. Makes part-shipments possible.
model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  status    ReturnStatus @default(REQUESTED)
  reason    String
  /// [{ orderItemId, quantity }]
  items     Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ───────────────────────────── Administration ─────────────────────────────

/// What each role may do is defined in src/server/permissions.ts.
enum AdminRole {
  SUPER_ADMINISTRATOR
  ADMINISTRATOR
  OPERATIONS_MANAGER
  WAREHOUSE_MANAGER
  SHIPPING_MANAGER
  CUSTOMER_SUPPORT
  ACCOUNTANT
  MARKETING_MANAGER
  ANALYST
  MANAGER
  STAFF
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          AdminRole @default(STAFF)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  /// Authenticator secret, encrypted with APP_SECRET. Present while enrolling; enforced once totpEnabledAt is set.
  totpSecret    String?
  totpEnabledAt DateTime?

  sessions          AdminSession[]
  notes             OrderNote[]
  verifiedDocuments BatchDocument[]
  orderEvents       OrderEvent[]
}

model AdminSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  ip          String?
  userAgent   String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Append-only record of sensitive actions by staff and by the system.
model AuditLog {
  id        String   @id @default(cuid())
  actorType String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  /// Deliberately not sent: the channel is switched off or not connected.
  SKIPPED
}

/// Transactional outbox. A row is written in the same transaction as the
/// business change, then delivered with retries. `dedupeKey` makes a job
/// impossible to enqueue twice (e.g. one WhatsApp message per paid order).
model OutboxJob {
  id        String    @id @default(cuid())
  kind      String
  payload   Json
  dedupeKey String    @unique
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAfter  DateTime  @default(now())
  lastError String?
  /// Set while a worker holds the job; a stale lock is released after ten minutes.
  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([status, runAfter])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Fixed-window counters for login, lookup and form endpoints.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

enum WholesaleStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

/// A grower, mill, bottler or packaging supplier. Internal records for traceability and purchasing.
model Supplier {
  id             String          @id @default(cuid())
  name           String
  /// What they supply: Grower, Mill, Bottler, Packaging, Logistics, Other.
  kind           String          @default("Other")
  contactName    String?
  email          String?
  phone          String?
  address        String?
  countryCode    String?         @db.Char(2)
  vatNumber      String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  batches        Batch[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive, name])
}

/// Stock ordered from a supplier. Receiving it adds the units to stock and records what they cost.
model PurchaseOrder {
  id          String              @id @default(cuid())
  sequence    Int                 @unique @default(autoincrement())
  supplierId  String
  /// DRAFT, ORDERED, RECEIVED or CANCELLED.
  status      String              @default("DRAFT")
  expectedAt  DateTime?           @db.Date
  orderedAt   DateTime?
  receivedAt  DateTime?
  notes       String?
  adminUserId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  lines       PurchaseOrderLine[]

  @@index([status, createdAt])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  variantId       String
  quantity        Int
  unitCostCents   Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         Variant       @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
}

/// A staff note about a customer. Never shown to the customer, but part of their data on a GDPR request.
model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  adminUserId String?
  body        String
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model JournalPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  kind        String    @default("Story")
  title       String
  standfirst  String    @default("")
  body        String    @default("")
  /// Recipe details: { serves, time, ingredients[], method[] }
  recipe      Json?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
